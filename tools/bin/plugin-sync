#!/usr/bin/env bash
# Install or reload the paseo-explorer plugin in the local Paseo daemon and verify it reaches running status.
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
plugin_id="paseo-explorer"

case "${1:-}" in
  --desc)
    echo "Typecheck, install or reload paseo-explorer in the local Paseo daemon, and verify its status."
    exit 0
    ;;
  --help | -h)
    cat <<'EOF'
Usage:
  plugin-sync [--logs N]

Description:
  Runs typecheck first, then installs or reloads `paseo-explorer` in the local Paseo daemon
  and verifies that `paseo plugin ls` reports it as `running`.

Options:
  --logs N        Number of recent plugin log lines to print (default: 15)
  --desc          Print a one-line summary for tool discovery
  -h, --help      Show this help message
EOF
    exit 0
    ;;
esac

recent_log_limit=15
if [[ "${1:-}" == "--logs" ]]; then
  recent_log_limit="${2:?--logs requires a line count}"
fi

"$project_root/tools/bin/typecheck"

# Capture plugin list output in a variable first to avoid SIGPIPE under set -o pipefail.
installed_plugins_output="$(paseo plugin ls 2>&1 || true)"
if [[ "$installed_plugins_output" == *"$plugin_id"* ]]; then
  paseo plugin reload "$plugin_id"
else
  paseo plugin install "$project_root"
fi

current_plugin_status="$(paseo plugin ls 2>&1)"
echo "$current_plugin_status" | grep "$plugin_id" || true
echo "--- last $recent_log_limit log lines ---"
paseo plugin logs "$plugin_id" 2>&1 | tail -n "$recent_log_limit" || true

if [[ "$current_plugin_status" != *"running"* ]]; then
  echo "Error: $plugin_id did not reach running status" >&2
  exit 1
fi
